rules_version = '2';

// Firestore security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Photo info: caption, location, time, owner, image path.
    match /photos/{photoId} {

      // Anyone signed in can see photos.
      allow read: if request.auth != null;

      // You can only add photos as yourself, and only edit your own.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;

      // TESTING ONLY: anyone signed in can delete any photo.
      // Before release, change to: request.auth != null && resource.data.uid == request.auth.uid
      allow delete: if request.auth != null;
    }

    // Image bytes for older photos saved before we used Storage.
    match /photoImages/{photoId} {
      allow read: if request.auth != null;

      // TESTING ONLY: anyone signed in can delete.
      allow delete: if request.auth != null;
    }
  }
}
