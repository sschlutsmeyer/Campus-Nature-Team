rules_version = '2';

// Firestore security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Photo info: caption, location, time, owner, image path.
    // Photos (map pins) are private to whoever took them. Other users only see a photo after
    // it's posted to the feed, and then only through the post, which copies its title, location,
    // and image path. So a pin that was never posted can't be seen by anyone else.
    match /photos/{photoId} {

      // Only the owner can see a photo.
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      // You can only add photos as yourself, and only edit your own (without changing the owner).
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      // TESTING ONLY: anyone signed in can delete any photo.
      // Before release, change to: signedIn() && resource.data.uid == request.auth.uid
      allow delete: if signedIn();
    }

    // Image bytes for older photos saved before we used Storage.
    match /photoImages/{photoId} {
      allow read: if signedIn();

      // TESTING ONLY: anyone signed in can delete.
      allow delete: if signedIn();
    }

    // Feed posts. A photo post's id is its photo's id, so each photo can be posted only once.
    match /posts/{postId} {

      // Title is required. Lengths match the limits in PostRepository.kt.
      function validText(data) {
        return data.title is string
          && data.title.trim().size() > 0
          && data.title.size() <= 100
          && data.description is string
          && data.description.size() <= 2000;
      }

      // The author can change the title and description, and nothing else about the post.
      function isOwnerEdit() {
        return resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description'])
          && validText(request.resource.data);
      }

      // Anyone can like, dislike, or clear their reaction, changing only their own entry.
      function isReactionChange() {
        let me = request.auth.uid;
        let oldLikes = resource.data.likedBy.toSet();
        let newLikes = request.resource.data.likedBy.toSet();
        let oldDislikes = resource.data.dislikedBy.toSet();
        let newDislikes = request.resource.data.dislikedBy.toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'dislikedBy'])
          && newLikes.difference(oldLikes).union(oldLikes.difference(newLikes)).hasOnly([me])
          && newDislikes.difference(oldDislikes).union(oldDislikes.difference(newDislikes)).hasOnly([me])
          && !(me in newLikes && me in newDislikes);
      }

      // Adding or deleting a comment moves the count by exactly one.
      function isCommentCountChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1);
      }

      // Anyone signed in can read the feed.
      allow read: if signedIn();

      // Post as yourself, starting with no reactions or comments. You can only share your own photo.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'description', 'createdAt',
            'photoId', 'storagePath', 'latitude', 'longitude', 'photoTakenAt',
            'likedBy', 'dislikedBy', 'commentCount'])
        && request.resource.data.uid == request.auth.uid
        && validText(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && request.resource.data.dislikedBy == []
        && request.resource.data.commentCount == 0
        && (request.resource.data.get('photoId', null) == null
          || (request.resource.data.photoId == postId
            && get(/databases/$(database)/documents/photos/$(postId)).data.uid == request.auth.uid));

      allow update: if signedIn() && (isOwnerEdit() || isReactionChange() || isCommentCountChange());

      // Only the author can delete a post.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();

        // Comment as yourself on a post that exists.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));

        // Whoever wrote a comment can delete it, and so can the post's author.
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
      }
    }
  }
}
