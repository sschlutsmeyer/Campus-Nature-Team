rules_version = '2';

// Storage security rules. Paste into Firebase console > Storage > Rules, then Publish.
service firebase.storage {
  match /b/{bucket}/o {

    // Photo images, stored as photos/{uid}/{photoId}.jpg.
    match /photos/{uid}/{fileName} {

      // Anyone signed in can view images.
      allow read: if request.auth != null;

      // You can only upload into your own folder: images under 10 MB.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // TESTING ONLY: anyone signed in can delete any image.
      // Before release, change to: request.auth != null && request.auth.uid == uid
      allow delete: if request.auth != null;
    }
  }
}
